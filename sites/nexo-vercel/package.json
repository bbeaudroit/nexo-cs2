{
  "name": "nexo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "sync:menu": "node scripts/sync-menu-contract.mjs && node scripts/sync-menu-site.mjs",
    "check:menu": "node scripts/sync-menu-site.mjs --check"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@vercel/blob": "2.8.2",
    "animejs": "4.4.0",
    "clsx": "2.1.1",
    "express": "5.1.0",
    "framer-motion": "14.7.1",
    "lucide": "0.468.0",
    "lucide-react": "1.63.0",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
